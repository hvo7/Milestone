# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Packaged Electron output — ~291MB of regenerable Chromium runtime.
# Rebuild with `npm run package`; never commit it.
release

# Sync documents written by a locally-run relay (server/relay.mjs). Same content
# as the files in a cloud sync folder: one opaque document per device, holding
# whatever that device last published.
relay-data

# PWA icons rendered from public/logo.svg by `npm run generate-icons`, which the
# Pages workflow runs before every build. Committing them would let the installed
# app icon drift from the source mark.
public/pwa-*.png

# Exported/recovered data bundles. These are verbatim dumps of personal task
# data — never commit one, especially now the repo is public. Ignored by pattern
# so an accidental export into the checkout can't be staged.
milestone-backup-*.json
milestone-recovered-*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The relay's key, written by deploy/oracle/setup.sh on the server. It is the
# only thing standing between the internet and your whole profile, so it lives
# on the machine that uses it and nowhere else — never in the repo.
.env
deploy/oracle/.env
