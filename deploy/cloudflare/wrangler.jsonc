{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "milestone-sync",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../.testing/cloudflare-app",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "MilestoneRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MilestoneRelay"] }],
  "observability": { "enabled": false }
}
